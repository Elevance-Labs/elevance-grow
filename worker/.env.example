# The Grow project (the same two values the app is built with).
GROW_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
GROW_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# This computer's own login in Grow: Settings > Workers > Add worker, then Set password.
# It can do nothing but take a job and hand back its findings.
GROW_AGENT_EMAIL=home-pc@grow-worker.dev
GROW_AGENT_PASSWORD=

# Optional. Leave blank for the defaults.
GROW_CLAUDE_BIN=
GROW_DENO_BIN=
# Claude Code model names: research does the bulk reading, writing the thesis and drafts.
GROW_MODEL_RESEARCH=
GROW_MODEL_WRITING=
GROW_JOB_TIMEOUT_MINUTES=
# A browser for pages that only show their text after running scripts. Off when blank.
# Pin a version you have looked at; it runs with its own profile, signed in to nothing.
# GROW_BROWSER_SERVER={"command":"npx","args":["-y","@playwright/mcp@VERSION","--user-data-dir","C:\\grow-browser"]}
